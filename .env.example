# Postgres connection string (must point at a DB with the pgvector extension available)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grievanceai

# AI provider key (used later by the real ai_service package; ai_client.py is mocked for now)
GEMINI_API_KEY=your-gemini-api-key-here

# WhatsApp Business API token, for POST /intake/whatsapp/webhook
WHATSAPP_TOKEN=your-whatsapp-token-here
